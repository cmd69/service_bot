# JellyBot MVP - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# Bot Configuration
BOT_TOKEN=tu_token_de_telegram_aqui
ADMIN_USER_ID=123456789

# Basic Configuration
DEBUG=False

# Redis Configuration (opcional para MVP)
REDIS_URL=redis://redis:6379/0

# Text System Configuration
# Rutas de archivos de textos (configurables desde docker-compose)
CUSTOM_TEXTS_PATH=/app/texts/custom_texts.json
GENERIC_TEXTS_PATH=/app/texts/generic_texts.json

# Configuración del sistema de textos
TEXTS_FALLBACK_TO_GENERIC=true
TEXTS_AUTO_RELOAD=false
TEXTS_ENCODING=utf-8
TEXTS_VERBOSE_LOGGING=true

# Database Configuration (MySQL)
MYSQL_ROOT_PASSWORD=subscription_bot_root
MYSQL_DATABASE=subscription_bot
MYSQL_USER=subscription_user
MYSQL_PASSWORD=subscription_pass

# Database Connection Variables for Application
DB_HOST=mysql
DB_PORT=3306
DB_NAME=subscription_bot
DB_USER=subscription_user
DB_PASSWORD=subscription_pass

# Complete Database URL
DATABASE_URL=mysql+pymysql://subscription_user:subscription_pass@mysql:3306/subscription_bot

# Crypto Wallets Configuration
# TRX (TRON) Wallets - separate multiple addresses with commas
TRX_WALLETS=TU_wallet_address_1,TU_wallet_address_2
TRX_WALLET_NAMES=Main TRX Wallet,Backup TRX Wallet

# BSC (Binance Smart Chain) Wallets - separate multiple addresses with commas  
BSC_WALLETS=0xYourBSCWalletAddress1,0xYourBSCWalletAddress2
BSC_WALLET_NAMES=Main BSC Wallet,Backup BSC Wallet

# Wallet Management
AUTO_CREATE_WALLETS=true

# Admin User Configuration
ADMIN_CHAT_ID=123456789
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=admin_password_123

# Plans Configuration
# Option 1: JSON string (inline)
# PLANS_CONFIG={"basic":{"name":"Plan Básico","duration_days":30,"number_accounts":2,"price":"7.00","description":"Plan básico con 2 cuentas para 30 días"},"premium":{"name":"Plan Premium","duration_days":180,"number_accounts":4,"price":"30.00","description":"Plan premium con 4 cuentas para 180 días"},"pro":{"name":"Plan Pro","duration_days":365,"number_accounts":6,"price":"50.00","description":"Plan Pro con 6 cuentas para 365 días"}}

# Option 2: JSON file path (recommended)
PLANS_CONFIG_FILE=plans_config.json

# Database Initialization
AUTO_CREATE_PLANS=true
AUTO_CREATE_ADMIN=true

# DBeaver Configuration
DBEAVER_ADMIN_NAME=admin
DBEAVER_ADMIN_PASSWORD=admin123
DBEAVER_JAVA_OPTS=-Xmx2g