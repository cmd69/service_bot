# JellyBot MVP - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# Bot Configuration
BOT_TOKEN=tu_token_de_telegram_aqui
ADMIN_USER_ID=123456789

# Basic Configuration
DEBUG=False

# Redis Configuration (opcional para MVP)
REDIS_URL=redis://redis:6379/0

# Text System Configuration
# Rutas de archivos de textos (configurables desde docker-compose)
CUSTOM_TEXTS_PATH=/app/texts/custom_texts.json
GENERIC_TEXTS_PATH=/app/texts/generic_texts.json

# Configuración del sistema de textos
TEXTS_FALLBACK_TO_GENERIC=true
TEXTS_AUTO_RELOAD=false
TEXTS_ENCODING=utf-8
TEXTS_VERBOSE_LOGGING=true