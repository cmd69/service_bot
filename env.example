# Copia este archivo como .env y configura tus valores

# ---------------------------
# ServiceBot - Variables de Entorno
# ---------------------------

# Bot Configuration
BOT_TOKEN=tu_token_de_telegram_aqui
ADMIN_CHAT_ID=1234567890
ADMIN_USERNAME=admin
ADMIN_PASSWORD=abcdefghijk

# Basic Configuration
DEBUG=False

# Scheduler Configuration
ENABLE_SCHEDULER=true  # Habilita tareas programadas automáticas (verificación de membresías expiradas)

# --------------------------------------
# ServiceBot - Customización del servicio
# --------------------------------------

# Rutas de archivos de textos (configurables desde docker-compose)
#CUSTOM_TEXTS_PATH=/app/texts/custom_texts.json
GENERIC_TEXTS_PATH=/app/texts/generic_texts.json

# Configuración del sistema de textos
TEXTS_FALLBACK_TO_GENERIC=true
TEXTS_AUTO_RELOAD=false
TEXTS_ENCODING=utf-8
TEXTS_VERBOSE_LOGGING=true

# --------------------------------
# ServiceBot - Planes y suscripcion
# --------------------------------


# Planes
PLANS_CONFIG_FILE=plans_config.json

# Billeteras 
# Wallet Management
AUTO_CREATE_WALLETS=true

# Crypto Wallets Configuration
# TRX (TRON) Wallets - separate multiple addresses with commas
TRX_WALLETS=TU_wallet_address_1,TU_wallet_address_2
TRX_WALLET_NAMES=Main TRX Wallet,Backup TRX Wallet

# BSC (Binance Smart Chain) Wallets - separate multiple addresses with commas  
BSC_WALLETS=0xYourBSCWalletAddress1,0xYourBSCWalletAddress2
BSC_WALLET_NAMES=Main BSC Wallet,Backup BSC Wallet

# ---------------------------
# ServiceBot - Conexión con MYSQL
# ---------------------------

# Database Initialization
AUTO_CREATE_PLANS=true
AUTO_CREATE_ADMIN=true

# Database Connection Variables for Application
DB_HOST=${MYSQL_SERVICE_NAME}
DB_PORT=3306
DB_NAME=servicebot
DB_USER=servicebot_user
DB_PASSWORD=servicebot_pass

# Complete Database URL
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${MYSQL_SERVICE_NAME}:${DB_PORT}/${DB_NAME}

# ---------------------
# MYSQL - Customizations
# ---------------------

# Database Configuration (MySQL)
MYSQL_ROOT_PASSWORD=servicebot_root
MYSQL_DATABASE=servicebot
MYSQL_USER=servicebot_user
MYSQL_PASSWORD=servicebot_pass

# ---------------------
# DBEAVER - Customizations
# ---------------------
DBEAVER_ADMIN_NAME=admin
DBEAVER_ADMIN_PASSWORD=admin123
DBEAVER_JAVA_OPTS=-Xmx2g

# ---------------------
# Default Docker Compose Configuration
# ---------------------
BOT_SERVICE_NAME=servicebot
BOT_CONTAINER_NAME=servicebot
MYSQL_SERVICE_NAME=servicebot_mysql
MYSQL_CONTAINER_NAME=servicebot_mysql
PHPMYADMIN_SERVICE_NAME=servicebot_phpmyadmin
PHPMYADMIN_CONTAINER_NAME=servicebot_phpmyadmin
DBEAVER_SERVICE_NAME=servicebot_dbeaver
DBEAVER_CONTAINER_NAME=servicebot_dbeaver

# Network and Volume Names
NETWORK_NAME=servicebot_network
MYSQL_VOLUME_NAME=servicebot_mysql_data
DBEAVER_VOLUME_NAME=servicebot_dbeaver_data